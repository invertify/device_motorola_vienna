# SurfaceFlinger
debug.sf.auto_latch_unsignaled=1
debug.sf.enable_gl_backpressure=false
debug.sf.enable_hwc_vds=0
debug.sf.enable_transaction_tracing=false
debug.sf.high_fps_early_gl_phase_offset_ns=-9055556
debug.sf.high_fps_early_phase_offset_ns=-9055556
debug.sf.high_fps_late_app_phase_offset_ns=-6944444
debug.sf.high_fps_late_sf_phase_offset_ns=-9055556
debug.sf.hwc.min.duration=2000000
debug.sf.predict_hwc_composition_strategy=0
debug.sf.treat_170m_as_sRGB=1
persist.sys.sf.native_mode=1
ro.surface_flinger.enable_frame_rate_override=false
ro.surface_flinger.force_hwc_copy_for_virtual_displays=true
